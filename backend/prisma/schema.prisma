// Student Vault Database Schema
// This schema models the existing Student Vault data for backend persistence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TopicStatus {
  learning
  reviewing
  ready
}

enum UserRole {
  student
  teacher
}

enum EnrollmentStatus {
  pending
  active
  declined
}

enum InterventionStatus {
  proposed
  approved
  in_progress
  completed
  cancelled
}

enum AttendanceRecordStatus {
  present
  absent
}

enum AssignmentStatus {
  pending
  in_progress
  completed
}

enum AssignmentPriority {
  low
  medium
  high
}

enum AssessmentType {
  quiz
  test
  exam
  assignment
  other
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique // Clerk user ID
  email         String    @unique
  name          String    @db.VarChar(40)
  passwordHash  String?   // Nullable for OAuth-only accounts
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncedAt  DateTime? // Last successful sync timestamp
  role          UserRole  @default(student)

  profile       Profile?
  topics        Topic[]
  attendanceSubjects AttendanceSubject[]
  resources     Resource[]
  assignments   Assignment[]
  assessments   Assessment[]
  taughtClasses Classroom[]
  enrollments   ClassroomEnrollment[] @relation("StudentEnrollments")
  createdInterventions Intervention[] @relation("InterventionAuthor")
  receivedInterventions Intervention[] @relation("InterventionStudent")
  interventionEvents InterventionEvent[] @relation("InterventionEventActor")

  @@map("users")
}

model Classroom {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(80)
  subject     String?  @db.VarChar(40)
  joinCode    String   @unique @db.VarChar(24)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enrollments ClassroomEnrollment[]
  interventions Intervention[]

  @@index([teacherId])
  @@map("classrooms")
}

model ClassroomEnrollment {
  id          String          @id @default(cuid())
  classroomId String
  classroom   Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User            @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(pending)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([classroomId, studentId])
  @@index([studentId, status])
  @@map("classroom_enrollments")
}

model Intervention {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("InterventionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("InterventionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  need        String   @db.VarChar(1000)
  action      String   @db.VarChar(1000)
  status      InterventionStatus @default(proposed)
  evidenceSummary String? @db.VarChar(2000)
  outcomeNote String?  @db.VarChar(2000)
  teacherFeedback String? @db.VarChar(2000)
  followUpRequired Boolean @default(false)
  reviewedAt DateTime?
  baselineScore Int?
  baselineMaxScore Int?
  followUpScore Int?
  followUpMaxScore Int?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      InterventionEvent[]

  @@index([classroomId, studentId, status])
  @@index([authorId])
  @@map("interventions")
}

model InterventionEvent {
  id             String   @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User     @relation("InterventionEventActor", fields: [actorId], references: [id], onDelete: Cascade)
  fromStatus     InterventionStatus?
  toStatus       InterventionStatus
  note           String?  @db.VarChar(2000)
  createdAt      DateTime @default(now())

  @@index([interventionId, createdAt])
  @@index([actorId])
  @@map("intervention_events")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Topic {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String       @db.VarChar(40)
  title       String       @db.VarChar(80)
  examDate    DateTime?
  notes       String       @db.Text
  status      TopicStatus  @default(learning)
  checklist   Json         // { understand: bool, practice: bool, revise: bool }
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  resources   Resource[]
  assignments Assignment[]
  assessments Assessment[]
  interventions Intervention[]

  @@index([userId])
  @@index([subject])
  @@index([examDate])
  @@map("topics")
}

model Assignment {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String             @db.VarChar(120)
  description String             @db.Text @default("")
  subject     String             @db.VarChar(40)
  topicId     String?
  topic       Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  status      AssignmentStatus   @default(pending)
  priority    AssignmentPriority @default(medium)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([subject])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([topicId])
  @@map("assignments")
}

model Assessment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String         @db.VarChar(120)
  subject   String         @db.VarChar(40)
  topicId   String?
  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  type      AssessmentType @default(exam)
  score     Int
  maxScore  Int
  date      DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([subject])
  @@index([type])
  @@index([date])
  @@index([topicId])
  @@map("assessments")
}

model AttendanceSubject {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String            @db.VarChar(40)
  target    Int               @default(75)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  records   AttendanceRecord[]

  @@index([userId])
  @@unique([userId, name])
  @@map("attendance_subjects")
}

model AttendanceRecord {
  id                  String                @id @default(cuid())
  attendanceSubjectId String
  attendanceSubject   AttendanceSubject     @relation(fields: [attendanceSubjectId], references: [id], onDelete: Cascade)
  record              AttendanceRecordStatus
  createdAt           DateTime              @default(now())

  @@index([attendanceSubjectId])
  @@map("attendance_records")
}

model Resource {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String   // application/pdf, image/*
  size        BigInt
  data        String?  @db.Text // Base64 data URL (for local storage fallback)
  r2Key       String?  // R2/S3 object key (when using cloud storage)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([topicId])
  @@map("resources")
}

# Student Vault Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env or any file with real secrets

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL for CORS (development)
# In production, set to your actual frontend domain
FRONTEND_URL=http://localhost:5173

# AI Services (Phase 4+)
# At least one AI provider is required for AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube Data API v3 (Phase 6)
# Get from Google Cloud Console
YOUTUBE_API_KEY=

# Brave Search API (Phase 7)
# Get from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Image Generation (optional integration; roadmap remains seven phases)
# Fal.ai API key (recommended) or OpenAI for DALL-E
FAL_API_KEY=

# Database (Phase 1+)
# PostgreSQL connection string (Neon, Supabase, local, etc.)
DATABASE_URL=

# Cloudflare R2 / S3-Compatible Storage (Phase 3+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Authentication (Phase 2+)
# Clerk (recommended) - get from https://clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Teacher role provisioning: comma-separated Clerk user IDs. All other accounts
# remain students; role changes apply on the next authenticated API request.
TEACHER_CLERK_IDS=

# Email Service (Phase 2+)
# SendGrid or Resend API key
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Error Monitoring (Optional)
# Sentry DSN
SENTRY_DSN=

# Combined production service: absolute directory containing frontend/dist.
# Leave unset when running Vite separately in development.
FRONTEND_DIST_DIR=
# Optional local PDF parser and consent-gated OCR
PDF_PYTHON_BIN=
OCR_PROVIDER=none
OCR_MODEL=gpt-4o-mini
